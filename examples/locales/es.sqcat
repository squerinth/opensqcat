!sqcat_format_version 1

# Messages are independent from the program's structure.
welcome = Hola, {playername}.
balance = Tienes {money} monedas.
access = {"Puedes editar" if logged_in and (owner or admin) else "Solo lectura"}
hint = Usa las flechas.
help = {playername}: {$hint}
brace = Escribe {"{playername}"} literalmente.
summary = {join(", ", playername, "propietario" if owner else "", "administrador" if admin else "")}
