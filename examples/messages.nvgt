#pragma console
#include "../src/opensqcat.nvgt"

string player_name = "Squerinth";

bool resolve_player(const string&in name, var@&out result) {
    if (name != "playername") {
        return false;
    }
    @result = var(player_name);
    return true;
}

void main() {
    opensqcat::translator messages;
    if (!messages.load("locales/es.sqcat") || !messages.load("locales/common.sqcat")) {
        println(messages.error.message);
        exit(1);
    }
    messages.set_resolver(resolve_player);
    if (!messages.set_variable("logged_in", true)
        || !messages.set_variable("owner", false)
        || !messages.set_variable("admin", true)) {
        println(messages.error.message);
        exit(1);
    }
    println(messages.get("welcome"));
    println(messages.get("balance", {{"money", 25}}));
    println(messages.get("access"));
    println(messages.get("help"));
    println(messages.get("summary"));
    println(messages.get_from("common", "help"));
    println(messages.format("{playername}: {$common/help}"));
    player_name = "Ana";
    println(messages.get("welcome"));
}
