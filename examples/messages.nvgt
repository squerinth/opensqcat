#include "../src/opensqcat.nvgt"

string player_name = "Sam";

bool resolve_player(const string&in name, var@&out result) {
	if (name != "playername") {
		return false;
	}
	@result = var(player_name);
	return true;
}

void main() {
	opensqcat::translator messages;
	if (!messages.load("locales/en.sqcat") || !messages.load("locales/common.sqcat")) {
		alert("OpenSQCat", messages.error.message);
		exit(1);
	}
	messages.set_resolver(resolve_player);
	if (!messages.set_variable("logged_in", true)
		|| !messages.set_variable("owner", false)
		|| !messages.set_variable("admin", true)) {
		alert("OpenSQCat", messages.error.message);
		exit(1);
	}
	alert("Welcome", messages.get("welcome"));
	alert("Balance", messages.get("balance", {{"money", 25}}));
	alert("Access", messages.get("access"));
	alert("Help", messages.get("help"));
	alert("Summary", messages.get("summary"));
	alert("Shared help", messages.get_from("common", "help"));
	alert("Inline help", messages.format("{playername}: {$common/help}"));
	player_name = "Alex";
	alert("Welcome", messages.get("welcome"));
}
